# ========================================
/public/hot
/public/storage
/public/build
npm-debug.log
yarn-error.log
pnpm-debug.log

# ========================================
# IDE / エディタ関連
# ========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ========================================
# Docker / DevContainer
# ========================================
docker-compose.override.yml
/.devcontainer/*.log
/.devcontainer/data/

